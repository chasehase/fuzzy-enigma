          <thead>
            <tr>
              <th>Category</th>
              <th>Information</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Main idea</strong></td>
              <td><span class="recall-target">Skill, art and craft</span></td>
