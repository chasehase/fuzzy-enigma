  <script>
    // 1. Recall / Study Mode Toggle & Individual Reveal
    const recallToggleBtn = document.getElementById("recallToggleBtn");
    const recallStatusText = document.getElementById("recallStatusText");
    const recallTargets = document.querySelectorAll(".recall-target");

    recallToggleBtn.addEventListener("click", () => {
      const isActive = document.body.classList.toggle("recall-mode");
      recallToggleBtn.classList.toggle("active", isActive);
      recallStatusText.textContent = isActive ? "ON" : "OFF";
      if (!isActive) {
        recallTargets.forEach(el => el.classList.remove("revealed"));
      }
    });

    recallTargets.forEach(el => {
      el.addEventListener("click", () => {
        if (document.body.classList.contains("recall-mode")) {
          el.classList.toggle("revealed");
        }
      });
    });

    // 2. Section Navigation / Tab Filter
    const navBtns = document.querySelectorAll(".nav-btn");
    const sections = document.querySelectorAll(".lesson-section");
    const heroCard = document.querySelector(".hero-card");

    navBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        navBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        const target = btn.dataset.target;

        if (target === "all") {
          heroCard.style.display = "block";
          sections.forEach(sec => sec.classList.remove("hidden-by-filter"));
          window.scrollTo({ top: 0, behavior: "smooth" });
        } else {
          heroCard.style.display = "none";
          sections.forEach(sec => {
            if (sec.id === target) {
              sec.classList.remove("hidden-by-filter");
            } else {
              sec.classList.add("hidden-by-filter");
            }
          });
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      });
    });

    // 3. Interactive Stepper in Section 1
    const stepTabs = document.querySelectorAll(".step-tab");
    const stepPanels = document.querySelectorAll(".step-panel");

    function goStep(index) {
      stepTabs.forEach((tab, i) => tab.classList.toggle("active", i === index));
      stepPanels.forEach((panel, i) => panel.classList.toggle("active", i === index));
    }

    stepTabs.forEach(tab => {
      tab.addEventListener("click", () => {
        goStep(Number(tab.dataset.step));
      });
    });

    // 4. Interactive Quiz & Score Tracker
    const quizItems = document.querySelectorAll(".quiz-item");
    const scoreBadge = document.getElementById("scoreBadge");
    const answeredCountEl = document.getElementById("answeredCount");
    const resetQuizBtn = document.getElementById("resetQuizBtn");
    const quizState = {}; // qid -> boolean (isCorrect)

    function updateScoreboard() {
      const total = quizItems.length;
      const answered = Object.keys(quizState).length;
      const correct = Object.values(quizState).filter(Boolean).length;
      scoreBadge.textContent = `${correct} / ${total}`;
      answeredCountEl.textContent = `(${answered} answered)`;
    }

    quizItems.forEach(item => {
      const qid = item.dataset.qid;
      const type = item.dataset.type;
      const correctAnswer = item.dataset.answer;
      const feedbackEl = item.querySelector(".feedback-msg");

      if (type === "mcq") {
        const btns = item.querySelectorAll(".mcq-btn");
        btns.forEach(btn => {
          btn.addEventListener("click", () => {
            const chosen = btn.dataset.opt;
            btns.forEach(b => b.classList.remove("selected-correct", "selected-wrong"));

            if (chosen === correctAnswer) {
              btn.classList.add("selected-correct");
              item.classList.remove("incorrect");
              item.classList.add("correct");
              feedbackEl.textContent = `Correct! The answer is ${correctAnswer}.`;
              feedbackEl.className = "feedback-msg show ok";
              quizState[qid] = true;
            } else {
              btn.classList.add("selected-wrong");
              item.classList.remove("correct");
              item.classList.add("incorrect");
              feedbackEl.textContent = `Not quite. Try again or review the word meanings above.`;
              feedbackEl.className = "feedback-msg show bad";
              quizState[qid] = false;
            }
            updateScoreboard();
          });
        });
      } else if (type === "fill") {
        const input = item.querySelector(".fill-input");
        const checkBtn = item.querySelector(".btn-check");

        const evaluateFill = () => {
          const userVal = input.value.trim().toLowerCase();
          if (!userVal) {
            feedbackEl.textContent = "Please type a word before checking.";
            feedbackEl.className = "feedback-msg show bad";
            return;
          }
          if (userVal === correctAnswer.toLowerCase()) {
            item.classList.remove("incorrect");
            item.classList.add("correct");
            feedbackEl.textContent = `Correct! "${item.dataset.qid === "q8" ? "Technically" : correctAnswer}" fits the sentence.`;
            feedbackEl.className = "feedback-msg show ok";
            quizState[qid] = true;
          } else {
            item.classList.remove("correct");
            item.classList.add("incorrect");
            feedbackEl.textContent = `Incorrect. Check spelling and part of speech (technique, technician, technical, or technically).`;
            feedbackEl.className = "feedback-msg show bad";
            quizState[qid] = false;
          }
          updateScoreboard();
        };

        checkBtn.addEventListener("click", evaluateFill);
        input.addEventListener("keydown", e => {
          if (e.key === "Enter") evaluateFill();
        });
      }
    });

    resetQuizBtn.addEventListener("click", () => {
      for (const key in quizState) {
        delete quizState[key];
      }
      quizItems.forEach(item => {
        item.classList.remove("correct", "incorrect");
        const feedbackEl = item.querySelector(".feedback-msg");
        feedbackEl.className = "feedback-msg";
        feedbackEl.textContent = "";
        item.querySelectorAll(".mcq-btn").forEach(b => b.classList.remove("selected-correct", "selected-wrong"));
        const input = item.querySelector(".fill-input");
        if (input) input.value = "";
      });
      updateScoreboard();
    });
  </script>
